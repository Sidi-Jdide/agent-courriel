# Copier ce fichier en .env puis remplir les valeurs
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

NOM_ENTREPRISE=Mon Entreprise
SIGNATURE=L'équipe de Mon Entreprise
FICHIER_CONNAISSANCES=connaissances.md

GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json
REQUETE_GMAIL=is:unread in:inbox newer_than:2d
MAX_PAR_CYCLE=20

# false = brouillons seulement (recommandé au début)
ENVOI_AUTO=false
CATEGORIES_ENVOI_AUTO=accuse_reception,question_frequente
DOMAINES_BLOQUES=

BASE_DONNEES=agent.db
ETIQUETTE=Agent-IA
